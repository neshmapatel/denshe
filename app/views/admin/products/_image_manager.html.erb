<div class="product-image-manager">
  <p>Choose the primary design for the storefront, or mark designs to remove.</p>
  <ul style="list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:1rem;">
    <% product.images.attachments.each do |image| %>
      <li style="width:200px;">
        <%= fullscreen_button image, alt: product.name, width: 200, height: 200, style: "display:block;width:200px;height:200px;object-fit:cover;" %>
        <label style="display:block;margin-top:0.4rem;">
          <%= radio_button_tag "product[primary_image_id]", image.id, product.primary_image?(image), id: "primary_image_#{image.id}" %>
          Primary for storefront
        </label>
        <label style="display:block;">
          <%= check_box_tag "product[remove_image_ids][]", image.id, false, id: "remove_image_#{image.id}" %>
          Remove this design
        </label>
      </li>
    <% end %>
  </ul>
</div>
