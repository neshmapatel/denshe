<% page_title "Selected pieces" %>
<% meta description: "Pieces you have selected from DeNshe, ready for checkout.", index: false %>

<section class="section section--tight">
  <div class="page page--narrow">
    <%= render "storefront/shared/checkout_steps", current: :pieces %>

    <header class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Your selection</p>
        <h1>Selected pieces.</h1>
      </div>
    </header>

    <% lines = current_cart.items %>
    <% combos = current_cart.combo_lines %>
    <% if lines.empty? && combos.empty? %>
      <div class="empty">
        <%= image_tag "denshe-mark-navy.png", alt: "", width: 87, height: 80 %>
        <h2>Nothing selected yet.</h2>
        <p>Choose a piece from the collection, then come back here to check out.</p>
        <%= link_to shop_path, class: "btn btn--solid" do %>
          <span>Explore the collection</span>
        <% end %>
      </div>
    <% else %>
      <ul class="bag">
        <% combos.each do |line| %>
          <li class="bag__row bag__row--plain">
            <div class="bag__copy">
              <p class="piece__meta">Look</p>
              <h2><%= line.combo.name %></h2>
              <p><%= line.products.map(&:name).to_sentence %></p>
              <p class="piece__price"><%= line.offered? ? price(line.line_total) : "Available in India" %></p>
            </div>
            <%= button_to "Remove", cart_combo_path(line.token), method: :delete, class: "link-quiet bag__remove" %>
          </li>
        <% end %>
        <% lines.each do |line| %>
          <% image = line.product.display_image %>
          <li class="bag__row<%= " bag__row--plain" unless image %>">
            <% if image %>
              <%= link_to piece_path(line.product.slug), class: "bag__photo" do %>
                <%= piece_image image, size: :thumb, alt: piece_alt(line.product) %>
              <% end %>
            <% end %>
            <div class="bag__copy">
              <p class="piece__meta"><%= line.product.category.name %></p>
              <h2><%= link_to line.product.name, piece_path(line.product.slug) %></h2>
              <p class="piece__price"><%= line.offered? ? price(line.line_total) : "Available in India" %></p>
            </div>
            <%= button_to "Remove", cart_item_path(line.product.slug), method: :delete, class: "link-quiet bag__remove" %>
          </li>
        <% end %>
      </ul>

      <div class="coupon">
        <% if current_cart.voucher %>
          <p class="coupon__applied"><%= current_cart.voucher.name %><%= " · #{current_cart.voucher.offer_label}" if current_cart.voucher.offer_label %> · <%= price(current_cart.voucher_discount) %> off</p>
        <% end %>
        <% if current_cart.coupon %>
          <p class="coupon__applied"><%= current_cart.coupon.code %> · <%= current_cart.coupon.percent_label %> off</p>
          <% if current_cart.coupon.customer %>
            <p class="checkout__note">This code is reserved for one customer. It is confirmed at checkout.</p>
          <% end %>
          <% if current_cart.coupon.valid_until %>
            <p class="checkout__note">Valid till <%= current_cart.coupon.valid_until.strftime("%-d %B %Y") %>.</p>
          <% end %>
        <% elsif current_cart.coupon_code.present? %>
          <p class="checkout__note">That code is no longer available.</p>
        <% end %>
        <%= form_with url: cart_coupon_path, class: "coupon__form" do %>
          <%= text_field_tag :code, nil, placeholder: "Code", autocomplete: "off", aria: { label: "Code" } %>
          <button type="submit" class="btn"><span>Apply</span></button>
        <% end %>
        <% if current_cart.coupon %>
          <%= button_to "Remove code", cart_coupon_path, method: :delete, class: "link-quiet" %>
        <% end %>
      </div>

      <div class="bag__total">
        <div>
          <p>Pieces</p>
          <p><%= price(current_cart.subtotal) %></p>
        </div>
        <% if current_cart.discount_amount.positive? %>
          <div>
            <p>Offer</p>
            <p>−<%= price(current_cart.discount_amount) %></p>
          </div>
        <% end %>
        <div>
          <p>Shipping</p>
          <p><%= shipping_label_for(current_cart.subtotal) %></p>
        </div>
        <div class="bag__due">
          <p><%= australia? ? "Total" : "To pay" %></p>
          <p><%= price(cart_due) %></p>
        </div>
        <% if (nudge = voucher_nudge(current_cart.subtotal)) %>
          <p class="bag__nudge"><%= nudge %></p>
        <% end %>
        <% if current_cart.items.any? { |line| !line.offered? } || combos.any? { |line| !line.offered? } %>
          <p class="checkout__note">Some pieces are part of the India shop. Remove them to check out here, or switch to India.</p>
          <%= link_to market_switch_path("in"), class: "btn btn--block" do %>
            <span>Shop in India</span>
          <% end %>
        <% else %>
          <% if australia? %>
            <p class="checkout__note">We'll write to you to confirm delivery and payment. Placing the order reserves the piece.</p>
          <% end %>
          <%= link_to checkout_path, class: "btn btn--solid btn--block" do %>
            <span>Checkout</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
