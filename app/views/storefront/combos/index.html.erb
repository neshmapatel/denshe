<% page_title "Looks" %>
<% meta description: "A few pieces, one price. You choose which ones, from the ones set aside." %>
<%= structured_data(breadcrumb_structured_data([ { name: "Looks", url: combos_url } ])) %>
<% if @combos.any? %>
  <%= structured_data(
        "@context" => "https://schema.org",
        "@type" => "ItemList",
        "name" => "DeNshe Curated Looks & Combo Sets",
        "url" => combos_url,
        "numberOfItems" => @combos.size,
        "itemListElement" => @combos.each_with_index.map do |combo, idx|
          {
            "@type" => "ListItem",
            "position" => idx + 1,
            "name" => combo.name,
            "url" => combo_url(combo.slug)
          }
        end
      ) %>
<% end %>

<header class="page-intro">
  <div class="page page--narrow">
    <p class="eyebrow">Put together</p>
    <h1>Looks</h1>
    <p class="lede">A few pieces, gathered for one price. You choose which ones.</p>
  </div>
</header>

<section class="section section--tight">
  <div class="page page--narrow">
    <% if @combos.any? %>
      <div class="combo-list">
        <% @combos.each do |combo| %>
          <%= link_to combo_path(combo.slug), class: "combo-card", id: "combo-card-#{combo.slug}" do %>
            <div class="combo-card__preview">
              <div class="combo-card__mosaic">
                <% sample_products = combo.groups.flat_map(&:products).select { |p| p.display_image.present? || (p.images.respond_to?(:attached?) && p.images.attached?) }.first(4) %>
                <% if sample_products.any? %>
                  <% sample_products.each_with_index do |product, idx| %>
                    <% image = product.display_image || product.images.first %>
                    <div class="combo-card__mosaic-item combo-card__mosaic-item--<%= idx + 1 %>">
                      <%= image_tag catalogue_image_source(image),
                            alt: product.name,
                            loading: "lazy",
                            decoding: "async" %>
                      <span class="combo-card__mosaic-tag"><%= product.name.split.first(2).join(" ") %></span>
                    </div>
                  <% end %>
                <% else %>
                  <div class="combo-card__mosaic-placeholder">
                    <%= image_tag "denshe-mark-navy.png", alt: "", width: 64, height: 60 %>
                    <span>Curated DeNshe Jewellery Set</span>
                  </div>
                <% end %>
              </div>
              <div class="combo-card__badges">
                <span class="combo-badge combo-badge--count">
                  <%= combo.groups.sum(&:choose_count) %>-Piece Bundle
                </span>
                <span class="combo-badge combo-badge--value">Special Price</span>
              </div>
            </div>

            <div class="combo-card__body">
              <div class="combo-card__meta">
                <p class="eyebrow">Choose <%= combo.choice_summary %></p>
                <h2><%= combo.name %></h2>
                <% if combo.short_description.present? %>
                  <p class="combo-card__desc"><%= combo.short_description %></p>
                <% end %>
              </div>

              <div class="combo-card__options">
                <div class="combo-card__options-header">
                  <span class="combo-card__options-title">Available options in this combo:</span>
                  <span class="combo-card__options-count"><%= combo.groups.map { |g| "#{g.choose_count} #{g.name.downcase}" }.join(" + ") %></span>
                </div>

                <div class="combo-card__groups">
                  <% combo.groups.each do |group| %>
                    <div class="combo-card__group-row">
                      <div class="combo-card__group-pill">
                        <strong>Pick <%= group.choose_count %></strong> <%= group.name %>
                        <span class="combo-card__group-avail">(<%= group.products.count %> <%= "design".pluralize(group.products.count) %> available)</span>
                      </div>
                      <div class="combo-card__options-chips">
                        <% group.products.first(3).each do |prod| %>
                          <% p_img = prod.display_image || (prod.images.respond_to?(:attached?) && prod.images.attached? && prod.images.first) %>
                          <span class="combo-chip" title="<%= prod.name %>">
                            <% if p_img %>
                              <%= image_tag catalogue_image_source(p_img), alt: prod.name, class: "combo-chip__img", loading: "lazy" %>
                            <% end %>
                            <span class="combo-chip__text"><%= prod.name %></span>
                          </span>
                        <% end %>
                        <% if group.products.count > 3 %>
                          <span class="combo-chip combo-chip--more">+<%= group.products.count - 3 %> more</span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="combo-card__footer">
                <div class="combo-card__pricing">
                  <span class="combo-card__price-label">Set bundle price</span>
                  <p class="piece__price combo-card__price"><%= price(combo.price) %></p>
                </div>
                <span class="btn btn--solid combo-card__btn">
                  <span>Choose the pieces →</span>
                </span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <%= image_tag "denshe-mark-navy.png", alt: "", width: 87, height: 80 %>
        <h2>Nothing to put together just yet.</h2>
        <p>When a look is ready, it will be here.</p>
        <%= link_to shop_path, class: "btn" do %>
          <span>Shop the collection</span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
