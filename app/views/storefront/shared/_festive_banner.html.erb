<% indian_live = collection_line_counts["indian"].to_i.positive? %>
<section class="festive-banner<%= " festive-banner--hero" if local_assigns[:on_hero] %>"
         aria-label="<%= indian_live ? 'Indian Collection' : 'Our festive edit is almost here' %>">
  <div class="page festive-banner__inner">
    <h2 class="festive-banner__title">A little more sparkle,<br>for the festive season ahead.</h2>
    <% if indian_live %>
      <p class="festive-banner__call">
        <%= link_to "Open the Indian Collection", collection_path("indian"), class: "festive-banner__link" %>
      </p>
    <% else %>
      <p class="festive-banner__call">Our festive edit is almost here.</p>
    <% end %>
  </div>
</section>
