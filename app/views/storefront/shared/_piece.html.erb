<% image = product.display_image %>
<% sold_out = !product.available_for_sale? %>
<article class="piece<%= " piece--text" unless image %><%= " piece--sold" if sold_out %>">
  <% if image %>
    <div class="piece__frame">
      <%= piece_image image, size: :card, alt: piece_alt(product) %>
    </div>
  <% end %>

  <div class="badges">
    <% if sold_out %>
      <span class="badge badge--sold">Sold out</span>
    <% else %>
      <% if listed_on_sale?(product) %>
        <span class="badge badge--gold"><%= listed_discount(product) %>% off</span>
      <% end %>
      <% if product.new_arrival? %>
        <span class="badge">New</span>
      <% end %>
      <% if product.bestseller? %>
        <span class="badge badge--paper">Bestseller</span>
      <% end %>
    <% end %>
  </div>

  <%= render "storefront/shared/save_button",
        product: product,
        label: "Save #{product.name} to your jewellery box" %>

  <div class="piece__body">
    <%= link_to piece_path(product.slug), class: "piece__link" do %>
      <p class="piece__meta">
        <%= product.collection_line_label %>
        · <%= product.category.name %>
        <% if product.colour.present? %>
          · <%= product.colour.titleize %>
        <% end %>
      </p>
      <h3 class="piece__name"><%= product.name %></h3>
    <% end %>
    <p class="piece__price">
      <% if listed_on_sale?(product) %>
        <del><%= price(listed_compare_price(product)) %></del>
        <ins><%= price(listed_price(product)) %></ins>
      <% else %>
        <%= price(listed_price(product)) %>
      <% end %>
    </p>
    <%= render "storefront/shared/availability", product: product %>
  </div>

  <% if product.available_for_sale? && !held_by_someone_else?(product) %>
    <% if current_cart.include?(product) %>
      <%= link_to cart_path, class: "btn btn--small btn--block piece__select" do %>
        <span>Selected</span>
      <% end %>
    <% else %>
      <%= button_to cart_items_path, params: { slug: product.slug },
            class: "btn btn--small btn--solid btn--block", form_class: "piece__select" do %>
        <span>Select</span>
      <% end %>
    <% end %>
  <% end %>
</article>
