<nav class="market-switch" aria-label="Shopping region">
  <%= link_to market_switch_path("in"), class: "market-switch__option", aria: { current: (australia? ? nil : "true") } do %>
    <span aria-hidden="true">₹</span>
    <span class="visually-hidden">India, prices in rupees</span>
  <% end %>
  <%= link_to market_switch_path("au"), class: "market-switch__option", aria: { current: (australia? ? "true" : nil) } do %>
    <span aria-hidden="true">A$</span>
    <span class="visually-hidden">Australia, prices in Australian dollars</span>
  <% end %>
</nav>
