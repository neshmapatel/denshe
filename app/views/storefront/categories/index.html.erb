<% page_title "Collections" %>
<% meta description: "Browse DeNshe by collection: The Modern Edit, The Festive Edit, then earrings, necklaces, rings, and the rest of the cabinet." %>

<header class="page-intro">
  <div class="page page--narrow">
    <p class="eyebrow">The cabinet</p>
    <h1>Collections</h1>
    <p class="lede">Two edits share the shelves — The Modern Edit for every day, and The Festive Edit for celebrations.</p>
  </div>
</header>

<% if @collection_lines.any? %>
  <section class="section section--tight">
    <div class="page">
      <header class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">The lines</p>
          <h2>The Modern Edit &amp; The Festive Edit</h2>
        </div>
      </header>
      <div class="collection-grid collection-grid--lines" data-reveal>
        <% @collection_lines.each do |line| %>
          <%= render "storefront/shared/collection_line_tile", line: line %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<section class="section section--tight">
  <div class="page">
    <% if @categories.any? %>
      <header class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">By type</p>
          <h2>The shelves</h2>
        </div>
      </header>
      <div class="collection-grid" data-reveal>
        <% @categories.each do |category| %>
          <%= render "storefront/shared/collection_tile", category: category %>
        <% end %>
      </div>
    <% elsif @collection_lines.empty? %>
      <div class="empty">
        <%= image_tag "denshe-mark-navy.png", alt: "", width: 87, height: 80 %>
        <h2>The shelves are being named.</h2>
        <p>Collections appear here as soon as a piece in them is ready to offer.</p>
        <%= link_to story_path, class: "btn" do %>
          <span>Our story</span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
