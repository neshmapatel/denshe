<% page_title "Jewellery Potlis & Jars · Launching Soon" %>
<% meta description: "Handcrafted jewellery potlis and curated jars from DeNshe Jewellery. Thoughtfully paired gifting sets, launching soon in Anand, Gujarat." %>

<header class="page-intro page-intro--ink">
  <div class="page page--narrow">
    <%= image_tag "denshe-mark-ivory.png", alt: "DeNshe Jewellery", class: "page-intro__mark", width: 87, height: 80 %>
    <p class="eyebrow">Curated Gifting</p>
    <h1>Jewellery Potlis &amp; Jars.</h1>
    <p class="lede">
      Handcrafted keepsake potlis and curated jewellery jars — each set thoughtfully paired for celebrations, everyday gifting, and meaningful moments. Launching soon.
    </p>
  </div>
</header>

<section class="section section--sand">
  <div class="page">
    <div class="section-head section-head--centred">
      <div class="section-head__text">
        <p class="eyebrow">Coming Soon</p>
        <h2>Thoughtfully crafted for gifting.</h2>
        <p class="lede">
          We are putting together our first collection of paired gift sets. Every potli and jar will feature clearly itemised, anti-tarnish and gold-tone jewellery from our signature collection.
        </p>
      </div>
    </div>

    <div class="contact-grid">
      <article class="contact-card">
        <p class="eyebrow">Edition 01</p>
        <h3>Handcrafted Potlis</h3>
        <p>Traditional raw silk and embroidered potlis paired with everyday earrings, kadas, and delicate pieces.</p>
      </article>

      <article class="contact-card">
        <p class="eyebrow">Edition 02</p>
        <h3>Jewellery Jars</h3>
        <p>Re-usable keepsake glass jars layered with everyday rings, chains, and anti-tarnish studs.</p>
      </article>

      <article class="contact-card">
        <p class="eyebrow">Edition 03</p>
        <h3>Occasion &amp; Bridal Sets</h3>
        <p>Curated gifting sets for bridesmaids, weddings, and festive celebrations, tailored with care.</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="page page--narrow centre" style="text-align: center;">
    <div class="ornament" aria-hidden="true" style="margin-bottom: 2rem;">
      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0 12 6 6 12 0 6Z" fill="currentColor"/></svg>
    </div>
    <p class="eyebrow">Launching Soon</p>
    <h2>Our first batch arrives shortly.</h2>
    <p class="lede" style="max-width: 36rem; margin: 0 auto 2.5rem;">
      Individual pieces are available right now in our shop. Explore our current catalogue or write to us for bespoke gifting enquiries.
    </p>
    <div class="hero__actions" style="justify-content: center; display: flex; gap: 1rem; flex-wrap: wrap;">
      <%= link_to shop_path, class: "btn btn--solid" do %>
        <span>Browse the collection</span>
      <% end %>
      <%= link_to contact_path, class: "btn" do %>
        <span>Contact for custom orders</span>
      <% end %>
    </div>
  </div>
</section>
