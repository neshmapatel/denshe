<% page_title "Contact" %>
<% meta description: "Write to DeNshe in Anand, Gujarat about a piece, a mystery box, or an order. We answer by email#{brand.whatsapp.present? ? " and WhatsApp" : ""}." %>

<header class="page-intro">
  <div class="page page--narrow">
    <p class="eyebrow"><%= brand.city %></p>
    <h1>Write to us.</h1>
    <p class="lede">A piece you want held, a box you want chosen, or a question about something you already wear. We read every note.</p>
  </div>
</header>

<section class="section section--tight">
  <div class="page">
    <div class="contact-grid">
      <article class="contact-card">
        <p class="eyebrow">Email</p>
        <h3><%= mail_to brand.email, brand.email %></h3>
        <p>Best for photographs and longer notes. We reply from Anand, Gujarat.</p>
      </article>

      <% if whatsapp_url %>
        <article class="contact-card">
          <p class="eyebrow">WhatsApp</p>
          <h3><%= link_to "Message DeNshe", whatsapp_url, target: "_blank", rel: "noopener" %></h3>
          <p>Useful when you are holding a piece in the jewellery box and want it set aside today.</p>
        </article>
      <% end %>

      <% if instagram_url %>
        <article class="contact-card">
          <p class="eyebrow">Instagram</p>
          <h3><%= link_to "@#{brand.instagram}", instagram_url, target: "_blank", rel: "noopener" %></h3>
          <p>New lots, as they are photographed.</p>
        </article>
      <% end %>

      <article class="contact-card">
        <p class="eyebrow">Dispatch</p>
        <h3><%= brand.ships_from %></h3>
        <p>Orders leave within <%= brand.dispatch_window %>. Shipping is <%= price(brand.standard_shipping) %> below <%= price(brand.free_shipping_above) %>, complimentary above.</p>
      </article>
    </div>
  </div>
</section>
