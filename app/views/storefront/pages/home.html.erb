<% page_title "Gold-tone earrings and everyday jewellery" %>
<% content_for :head do %>
  <link rel="preload" as="image" href="<%= image_path("denshe-wordmark-ivory.png") %>" fetchpriority="high">
<% end %>
<% meta description: "Jewellery from Anand, Gujarat. Gold-tone and anti-tarnish earrings, kadas, rings, and chains, with the price on every piece." %>
<%= structured_data(
      "@context" => "https://schema.org",
      "@graph" => [
        {
          "@type" => "Organization",
          "name" => brand.name,
          "url" => root_url,
          "logo" => absolute_asset(image_url("denshe-logo.jpg")),
          "email" => brand.email,
          "telephone" => brand.phone,
          "address" => {
            "@type" => "PostalAddress",
            "addressLocality" => "Anand",
            "addressRegion" => "Gujarat",
            "postalCode" => "388001",
            "addressCountry" => "IN"
          },
          "sameAs" => [ instagram_url ].compact
        },
        {
          "@type" => "WebSite",
          "name" => brand.name,
          "url" => root_url,
          "potentialAction" => {
            "@type" => "SearchAction",
            "target" => "#{shop_url}?q={search_term_string}",
            "query-input" => "required name=search_term_string"
          }
        }
      ]
    ) %>

<section class="hero">
  <div class="hero__panel">
    <div class="hero__logo-wrap">
      <%= image_tag "denshe-wordmark-ivory.png", alt: "DeNshe Jewellery", class: "hero__logo", width: 688, height: 293, fetchpriority: "high" %>
    </div>
    <div class="hero__intro">
      <p class="eyebrow hero__kicker">Jewellery, between us</p>
      <h1 class="hero__tagline">A little something,<br>chosen to feel like you.</h1>
      <p class="hero__copy">
        Two friends. Different continents. One shared dream — to bring you jewellery that feels personal, effortless and entirely yours.
      </p>
    </div>
    <div class="hero__actions">
      <%= link_to shop_path, class: "btn btn--ivory btn--solid" do %>
        <span>Explore the collection</span>
      <% end %>
      <% unless australia? %>
        <%= link_to potlis_and_jars_path, class: "btn btn--ivory" do %>
          <span>Discover Potlis & Jars</span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="horizon">
  <div class="page horizon__layout">
    <div class="horizon__copy">
      <p class="horizon__title">Jewellery for the moments<br>that feel like yours.</p>
      <p class="horizon__note">From everyday little joys to moments worth remembering.</p>
      <p class="horizon__price">Gold-tone and anti-tarnish. The price is on every piece.</p>
      <% if nav_categories.any? %>
        <nav class="horizon__shelves" aria-label="Shop by type">
          <% nav_categories.each do |category| %>
            <%= link_to category.name, collection_path(category.slug), class: "link-quiet" %>
          <% end %>
        </nav>
      <% end %>
    </div>
    <figure class="horizon__figure">
      <%= image_tag "denshe-moments.jpg", alt: "Pearl and gold jewellery arranged beneath the DeNshe mark", width: 1024, height: 682, loading: "lazy" %>
    </figure>
  </div>
</section>

<% if @looks.any? %>
  <section class="section" data-reveal>
    <div class="page">
      <header class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">Looks</p>
          <h2>A few pieces, one price.</h2>
          <p class="lede">Open a look, choose the pieces, and take it to checkout.</p>
        </div>
        <%= link_to "All looks", combos_path, class: "link-quiet" %>
      </header>
      <div class="combo-list combo-list--home">
        <% @looks.each do |combo| %>
          <%= link_to combo_path(combo.slug), class: "combo-card" do %>
            <p class="eyebrow">Choose <%= combo.choice_summary %></p>
            <h2><%= combo.name %></h2>
            <% if combo.short_description.present? %>
              <p><%= combo.short_description %></p>
            <% end %>
            <p class="piece__price"><%= price(combo.price) %></p>
            <span class="link-quiet">Choose the pieces</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<ol class="promises">
  <li>
    <span>01</span>
    <h2>Thoughtfully curated</h2>
    <p>Pieces chosen with intention.</p>
  </li>
  <li>
    <span>02</span>
    <h2>Everyday elegance</h2>
    <p>Jewellery made to move with you.</p>
  </li>
  <li>
    <span>03</span>
    <h2>Ready to gift</h2>
    <p>Little details, made for meaningful moments.</p>
  </li>
</ol>

<section class="section" data-reveal>
  <div class="page">
    <div class="split__body between">
      <h2>Between us.</h2>
      <p class="lede">
        Two lives in two different places.<br>
        A friendship that never really felt far away.<br>
        And somewhere along the way, an idea became a dream.
      </p>
      <p>
        DeNshe is that dream — a jewellery label born from the things we love, the conversations we keep coming back to, and the little details that make something feel like yours.
      </p>
      <%= link_to "Read our story", story_path, class: "link-quiet" %>
    </div>
  </div>
</section>

<% unless australia? %>
  <section class="section section--ink" data-reveal>
    <div class="page centre">
      <p class="eyebrow">Jewellery Potlis & Jars</p>
      <h2>Curated gifting sets.<br>Launching soon.</h2>
      <%= link_to potlis_and_jars_path, class: "btn btn--ivory" do %>
        <span>Explore Potlis & Jars</span>
      <% end %>
    </div>
  </section>
<% end %>

<% if instagram_url %>
  <section class="section" data-reveal>
    <div class="page centre">
      <h2>Little moments from DeNshe.</h2>
      <%= link_to instagram_url, class: "link-quiet", rel: "noopener", target: "_blank" do %>
        On Instagram
      <% end %>
    </div>
  </section>
<% end %>
