<% page_title "Payment" %>
<% meta description: "Payment for your DeNshe order. Nothing is charged yet." %>

<section class="section section--tight">
  <div class="page page--narrow">
    <%= render "storefront/shared/checkout_steps", current: :payment %>

    <header class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Order <%= @order.number %></p>
        <h1>Payment.</h1>
        <p class="lede">Your details are saved. Nothing has been charged yet.</p>
      </div>
    </header>

    <div class="pay">
      <ul class="checkout__lines">
        <% @order.order_items.each do |item| %>
          <li>
            <span><%= item.quantity %> × <%= item.name %></span>
            <span><%= price(item.line_total) %></span>
          </li>
        <% end %>
        <li>
          <span>Shipping</span>
          <span><%= @order.shipping_amount.to_d.positive? ? price(@order.shipping_amount) : "Complimentary" %></span>
        </li>
      </ul>

      <div class="bag__due">
        <p>To pay</p>
        <p><%= price(@order.total) %></p>
      </div>

      <div class="pay__addresses">
        <div>
          <p class="eyebrow">Shipping</p>
          <p><%= @order.guest_name %></p>
          <p><%= @order.shipping_address %></p>
          <% if @order.guest_phone.present? %>
            <p><%= @order.guest_phone %></p>
          <% end %>
        </div>
        <div>
          <p class="eyebrow">Billing</p>
          <p><%= @order.billing_address %></p>
        </div>
      </div>

      <% if payments_open? %>
        <% latest = @order.payments.order(created_at: :desc).first %>
        <div data-controller="payment"
             data-payment-key-value="<%= RazorpayGateway.key_id %>"
             data-payment-create-url-value="<%= checkout_razorpay_order_path %>"
             data-payment-verify-url-value="<%= checkout_payment_verify_path %>"
             data-payment-status-url-value="<%= checkout_payment_status_path %>"
             data-payment-failure-url-value="<%= checkout_payment_failure_path %>">
          <% saved_error = latest&.error_message if latest&.failed? || latest&.cancelled? %>
          <p class="field__error" data-payment-target="error" <%= "hidden" if saved_error.blank? %>><%= saved_error %></p>
          <button type="button" class="btn btn--solid btn--block" data-action="payment#pay">
            <span>Pay <%= price(@order.total) %></span>
          </button>
          <% if RazorpayGateway.key_id.start_with?("rzp_test_") %>
            <p class="checkout__note">Test mode. UPI success@razorpay, or a domestic test card. International cards are declined.</p>
          <% else %>
            <p class="checkout__note">After you pay with UPI, wait a moment on this page. We will take you to the confirmation once Razorpay confirms it.</p>
          <% end %>
        </div>
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
      <% else %>
        <div class="checkout__note">
          <p>Your order with DeNshe Jewellery is saved — thank you for choosing us.</p>
          <p>Online payment is finishing its last checks and will open here very soon. We will write to you the moment you can complete this order online, so nothing is lost.</p>
          <% if @order.guest_email.present? || @order.guest_phone.present? %>
            <p>We have your <%= [ @order.guest_email.presence && "email", @order.guest_phone.presence && "phone" ].compact.to_sentence %> ready for that note.</p>
          <% end %>
        </div>
      <% end %>

      <%= link_to shop_path, class: "btn" do %>
        <span>Back to the collection</span>
      <% end %>
    </div>
  </div>
</section>
