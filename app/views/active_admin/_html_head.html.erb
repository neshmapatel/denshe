<%= stylesheet_link_tag "active_admin" %>
<%= stylesheet_link_tag "image_lightbox" %>
<meta name="viewport" content="width=device-width,initial-scale=1">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<% # On page load or when changing themes, best to add inline in `head` to avoid FOUC %>
<%= javascript_tag nonce: true do %>
  if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark')
  } else {
    document.documentElement.classList.remove('dark')
  }

  window.densheShareInvoice = function (event, link) {
    if (!navigator.share) return

    event.preventDefault()
    var fallback = link.href
    fetch(link.dataset.invoicePdf)
      .then(function (response) { return response.blob() })
      .then(function (blob) {
        var file = new File([blob], link.dataset.invoiceName, { type: "application/pdf" })
        if (!navigator.canShare || !navigator.canShare({ files: [file] })) {
          window.open(fallback, "_blank", "noopener")
          return
        }
        return navigator.share({ files: [file], title: link.dataset.invoiceName, text: link.dataset.invoiceNote })
      })
      .catch(function (error) {
        if (error && error.name === "AbortError") return
        window.open(fallback, "_blank", "noopener")
      })
  }
<% end %>
<%= javascript_importmap_tags "active_admin", importmap: ActiveAdmin.importmap %>
