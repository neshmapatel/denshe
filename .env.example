# Copy to .env if you prefer environment variables locally.
# Rails already loads config/database.yml for development.

# ADMIN_SEED_PASSWORD=change-me-before-sharing

# Production database (Kamal/hosting will set this)
# DATABASE_URL=postgres://denshe:password@localhost/denshe_production
# DENSHE_DATABASE_PASSWORD=

# Production image storage. Leave unset to keep Active Storage on local disk.
# ACTIVE_STORAGE_SERVICE=cloudflare_r2
# CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=denshe-media
