# Copy to .env if you prefer environment variables locally.
# Rails already loads config/database.yml for development.

# ADMIN_SEED_PASSWORD=change-me-before-sharing

# Production database (Kamal/hosting will set this)
# DATABASE_URL=postgres://denshe:password@localhost/denshe_production
# DENSHE_DATABASE_PASSWORD=

# Production image storage. Leave unset to keep Active Storage on local disk.
# ACTIVE_STORAGE_SERVICE=cloudflare_r2
# CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=denshe-media

# Razorpay. Use test keys locally (rzp_test_...). The secret never goes in the page.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard (Settings → Webhooks).
# RAZORPAY_WEBHOOK_SECRET=
# Show the Pay button on checkout. Keep false until Razorpay website approval is done.
# PAYMENTS_OPEN=false
# Public storefront hold. false = shop is open to everyone.
# STOREFRONT_HELD=false

# Public contact + order notification inbox.
# DENSHE_CONTACT_EMAIL=denshe1713@gmail.com
# ORDER_NOTIFY_EMAIL=denshe1713@gmail.com
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=denshe1713@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_DOMAIN=denshe.shop
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# MAIL_FROM=DeNshe Jewellery <denshe1713@gmail.com>
